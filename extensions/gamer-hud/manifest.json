{
  "manifest_version": 2,
  "id": "gamer-hud",
  "name": "Gamer HUD",
  "version": "2.0.0",
  "description": "Real-time hardware telemetry and performance HUD. Monitor per-core CPU load, GPU utilization, VRAM, and thermal headroom.",
  "author": "BYTEDz",
  "icon": "icon.svg",
  "category": "System",
  "pclink_version": ">=4.9.0",
  "min_server_version": "4.8.0",
  "permissions": [
    "system.exec",
    "storage.local"
  ],
  "declared_permissions": [
    "system.exec",
    "storage.local"
  ],
  "supported_platforms": [
    "windows",
    "linux",
    "darwin"
  ],
  "supported_architectures": [
    "x86_64",
    "amd64",
    "arm64",
    "aarch64"
  ],
  "ui_capabilities": {
    "prevent_sleep": true,
    "allow_fullscreen": true
  },
  "contributes": {
    "views": [
      {
        "id": "gamer-hud-main",
        "title": "Gamer HUD",
        "icon": "cpu",
        "entry_point": "templates/index.html",
        "target": "main_tab"
      }
    ],
    "dashboard_widgets": [
      {
        "id": "gamer-hud-widget",
        "title": "Hardware HUD",
        "type": "webview",
        "entry_point": "templates/widget.html",
        "size": {
          "w": 1,
          "h": 2
        }
      }
    ]
  },
  "backend": {
    "runtime": "python",
    "entry_point": "extension.py:Extension",
    "isolated": true,
    "resource_limits": {
      "max_memory_mb": 128,
      "max_cpu_percent": 40,
      "execution_timeout_sec": 30
    }
  }
}