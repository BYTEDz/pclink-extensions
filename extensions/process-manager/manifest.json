{
  "manifest_version": 2,
  "id": "process-manager",
  "name": "Task Manager",
  "version": "2.0.0",
  "description": "Real-time process monitor and task manager. Inspect memory usage, CPU load, and terminate frozen processes.",
  "author": "BYTEDz",
  "icon": "icon.svg",
  "category": "System",
  "pclink_version": ">=4.9.0",
  "min_server_version": "4.8.0",
  "permissions": [
    "system.exec",
    "storage.local"
  ],
  "declared_permissions": [
    "system.exec",
    "storage.local"
  ],
  "supported_platforms": [
    "windows",
    "linux",
    "darwin"
  ],
  "supported_architectures": [
    "x86_64",
    "amd64",
    "arm64",
    "aarch64"
  ],
  "ui_capabilities": {
    "prevent_sleep": true,
    "allow_fullscreen": true
  },
  "contributes": {
    "views": [
      {
        "id": "process-manager-main",
        "title": "Task Manager",
        "icon": "activity",
        "entry_point": "templates/index.html",
        "target": "main_tab"
      }
    ],
    "dashboard_widgets": []
  },
  "backend": {
    "runtime": "none"
  }
}